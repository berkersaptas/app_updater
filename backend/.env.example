DATABASE_URL=postgres://ota:ota@localhost:5432/ota
ADMIN_API_KEY=dev-admin-key
ARTIFACT_STORAGE_DIR=/data/artifacts
PORT=8080
SESSION_SECRET=dev-session-secret-change-me
# Keep false in Play/production. Set true only for local POC tests that deliberately upload a full .so.
ALLOW_FULL_AOT_LIBRARY=false
SIGNING_MASTER_KEY=replace-with-an-exactly-32-byte-key
